# z/VM Configuration for Arch Linux s390x Build
# Copy this file to .env and fill in your values
# Add the entire .env file content as ZVM_CONFIG secret in GitHub Actions

# z/VM Connection Details
ZVM_HOST=zvm.example.com
ZVM_USER=your-zvm-user
ZVM_PORT=22

# SSH Key Configuration
# The SSH private key content (multiline)
ZVM_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
... (your full SSH private key content here) ...
-----END OPENSSH PRIVATE KEY-----"

# Build Configuration
# Note: the two SYSTEMD_* paths below are not read by anything in this
# repository at present. They describe directories on the z/VM guest.
BUILD_TIMEOUT_MINUTES=30
SYSTEMD_BUILD_DIR="/home/$ZVM_USER/systemd-build"
SYSTEMD_OUTPUT_DIR="/home/$ZVM_USER/systemd-minimal"

# Connection Settings
SSH_CONNECT_TIMEOUT=10
SSH_STRICT_HOST_KEY_CHECKING=no